+                ngx.say("get consumer failed")
+                return
+            end
+
+            local json = require("toolkit.json")
+            local res = json.decode(body)
+            if res.value and res.value.group_id == "test_group" then
+                ngx.say("passed")
+            else
+                ngx.say("group_id not found or mismatch")
+            end
+        }
+    }
