+--- Safe deep copy with depth and size limits.
+-- Returns copy, overflow_warning where overflow_warning is true if limits were approached/exceeded.
+local function safe_deepcopy(orig, resource_type, index)
+    local depth = 0
+    local key_count = 0
+    local overflow_warning = false
+
+    local function _safe_copy(o, copied, current_depth)
+        if type(o) ~= "table" then
+            return o
+        end
+
+        current_depth = current_depth + 1
+        if current_depth > DEEPCOPY_MAX_DEPTH then
+            overflow_warning = true
+            core.log.warn("deepcopy depth limit exceeded at ", resource_type, "[", index,
+                "], depth=", current_depth, ", returning shallow reference")
+            return o  -- return original to avoid stack overflow
+        end
+
+        if current_depth > DEEPCOPY_WARN_DEPTH then
+            core.log.warn("deepcopy approaching depth limit at ", resource_type, "[", index,
+                "], depth=", current_depth)
+        end
+
+        -- Check if already copied (handle circular references)
+        if copied[o] then
+            return copied[o]
+        end
+
+        local len = #o
+        local copy = core.table.new(len, 0)
+        copied[o] = copy
+
+        for k, v in pairs(o) do
+            key_count = key_count + 1
+            if key_count > DEEPCOPY_MAX_KEYS then
+                overflow_warning = true
+                core.log.warn("deepcopy key count limit exceeded at ", resource_type, "[", index,
+                    "], keys=", key_count, ", stopping copy")
+                break
+            end
+            copy[_safe_copy(k, copied, current_depth)] = _safe_copy(v, copied, current_depth)
+        end
+
+        local mt = getmetatable(o)
+        if mt ~= nil then
+            setmetatable(copy, mt)
+        end
+
+        return copy
+    end
+
+    local copied_recorder = {}
+    local result = _safe_copy(orig, copied_recorder, 0)
+
+    if key_count > DEEPCOPY_MAX_KEYS * 0.8 then
+        core.log.info("deepcopy processed large config at ", resource_type, "[", index,
+            "], keys=", key_count, ", depth=", depth)
+    end
+
+    return result, overflow_warning
+end
